{
  "required_java_major": 21,
  "main_class": "net.minecraft.client.main.Main",
  "classpath_entries": [
    "<GAME_DIR>/libraries/com/mojang/authlib/6.0.54/authlib-6.0.54.jar",
    "<GAME_DIR>/libraries/org/apache/logging/log4j/log4j-api/2.22.1/log4j-api-2.22.1.jar",
    "<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3.jar",
    "<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3-natives-windows.jar",
    "<GAME_DIR>/versions/1.21.1/1.21.1.jar"
  ],
  "jvm_args": [
    "-Xmx4096m",
    "-XX:+UnlockExperimentalVMOptions",
    "-XX:+UseG1GC",
    "-XX:-OmitStackTraceInFastThrow",
    "-Djdk.lang.Process.allowAmbiguousCommands=True",
    "-Dstdout.encoding=UTF-8",
    "-Dstderr.encoding=UTF-8",
    "-XX:HeapDumpPath=MojangTricksIntelDriversForPerformance_javaw.exe_minecraft.exe.heapdump",
    "-Dos.name=Windows 10",
    "-Dos.version=10.0",
    "-Djava.library.path=<GAME_DIR>/versions/1.21.1/1.21.1-natives",
    "-Djna.tmpdir=<GAME_DIR>/versions/1.21.1/1.21.1-natives",
    "-Dorg.lwjgl.system.SharedLibraryExtractPath=<GAME_DIR>/versions/1.21.1/1.21.1-natives",
    "-Dio.netty.native.workdir=<GAME_DIR>/versions/1.21.1/1.21.1-natives",
    "-Dminecraft.launcher.brand=PCL",
    "-Dminecraft.launcher.version=408",
    "-cp",
    "<GAME_DIR>/libraries/com/mojang/authlib/6.0.54/authlib-6.0.54.jar;<GAME_DIR>/libraries/org/apache/logging/log4j/log4j-api/2.22.1/log4j-api-2.22.1.jar;<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3.jar;<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3-natives-windows.jar;<GAME_DIR>/versions/1.21.1/1.21.1.jar"
  ],
  "game_args": [
    "--username",
    "StevePlayer",
    "--version",
    "1.21.1",
    "--gameDir",
    "<GAME_DIR>",
    "--assetsDir",
    "<GAME_DIR>/assets",
    "--assetIndex",
    "17",
    "--uuid",
    "11111111-2222-3333-4444-555555555555",
    "--accessToken",
    "mock_access_token_abc",
    "--clientId",
    "${clientid}",
    "--xuid",
    "${auth_xuid}",
    "--userType",
    "msa",
    "--versionType",
    "PCL",
    "--width",
    "1280",
    "--height",
    "720"
  ]
}