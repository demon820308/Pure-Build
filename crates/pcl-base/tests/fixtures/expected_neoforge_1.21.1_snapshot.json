{
  "required_java_major": 21,
  "main_class": "cpw.mods.bootstraplauncher.BootstrapLauncher",
  "classpath_entries": [
    "<GAME_DIR>/libraries/com/mojang/authlib/6.0.54/authlib-6.0.54.jar",
    "<GAME_DIR>/libraries/org/apache/logging/log4j/log4j-api/2.22.1/log4j-api-2.22.1.jar",
    "<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3.jar",
    "<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3-natives-linux.jar",
    "<GAME_DIR>/libraries/net/neoforged/neoforge/21.1.65/neoforge-21.1.65.jar",
    "<GAME_DIR>/libraries/cpw/mods/bootstraplauncher/2.0.2/bootstraplauncher-2.0.2.jar",
    "<GAME_DIR>/versions/1.21.1/1.21.1.jar"
  ],
  "jvm_args": [
    "-Xmx8192m",
    "-XX:+UnlockExperimentalVMOptions",
    "-XX:+UseG1GC",
    "-XX:-OmitStackTraceInFastThrow",
    "-Djdk.lang.Process.allowAmbiguousCommands=True",
    "-Dstdout.encoding=UTF-8",
    "-Dstderr.encoding=UTF-8",
    "-Djava.library.path=<GAME_DIR>/versions/neoforge-21.1.65/neoforge-21.1.65-natives",
    "-Djna.tmpdir=<GAME_DIR>/versions/neoforge-21.1.65/neoforge-21.1.65-natives",
    "-Dorg.lwjgl.system.SharedLibraryExtractPath=<GAME_DIR>/versions/neoforge-21.1.65/neoforge-21.1.65-natives",
    "-Dio.netty.native.workdir=<GAME_DIR>/versions/neoforge-21.1.65/neoforge-21.1.65-natives",
    "-Dminecraft.launcher.brand=PCL",
    "-Dminecraft.launcher.version=408",
    "-cp",
    "<GAME_DIR>/libraries/com/mojang/authlib/6.0.54/authlib-6.0.54.jar:<GAME_DIR>/libraries/org/apache/logging/log4j/log4j-api/2.22.1/log4j-api-2.22.1.jar:<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3.jar:<GAME_DIR>/libraries/org/lwjgl/lwjgl/3.3.3/lwjgl-3.3.3-natives-linux.jar:<GAME_DIR>/libraries/net/neoforged/neoforge/21.1.65/neoforge-21.1.65.jar:<GAME_DIR>/libraries/cpw/mods/bootstraplauncher/2.0.2/bootstraplauncher-2.0.2.jar:<GAME_DIR>/versions/1.21.1/1.21.1.jar",
    "-Dneoforge.logging.markers=REGISTRIES",
    "-Dneoforge.logging.console.level=debug"
  ],
  "game_args": [
    "--username",
    "NeoPlayer",
    "--version",
    "neoforge-21.1.65",
    "--gameDir",
    "<GAME_DIR>",
    "--assetsDir",
    "<GAME_DIR>/assets",
    "--assetIndex",
    "17",
    "--uuid",
    "55a5228ca5d74e4fb3bd99aa10d8cd98",
    "--accessToken",
    "0",
    "--clientId",
    "${clientid}",
    "--xuid",
    "${auth_xuid}",
    "--userType",
    "legacy",
    "--versionType",
    "PCL",
    "--width",
    "1920",
    "--height",
    "1080",
    "--fml.neoForgeVersion",
    "21.1.65"
  ]
}